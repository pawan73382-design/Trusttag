# TrustTag Environment Configuration

# Optional: LLM API Keys (for live CrewAI online mode)
# If omitted or offline mode is toggled, TrustTag runs in deterministic OFFLINE DEMO MODE
OPENAI_API_KEY=Blank
GEMINI_API_KEY="your-gemini-api-key-here"

# Model Configuration
OPENAI_MODEL_NAME="gpt-4o-mini"

# Streamlit Port Configuration (Defaults to 8501 locally, or 3000 in container)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
